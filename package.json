{
    "name": "rt-timing",
    "description": "RT Technologies' internal task timing and tracking software. To be distributed on RPi Linux",
    "author": {
        "name": "Nick Martens",
        "email": "Nick@rttechno.com"
    },
    "private": true,
    "version": "0.3.13",
    "type": "module",
    "main": "dist-electron/main.js",
    "scripts": {
        "start": "concurrently \"npm run server\" \"npm run client\"",
        "server": "tsx src/backend/server.ts",
        "client": "react-scripts start",
        "dev": "vite",
        "electron": "electron .",
        "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
        "build": "vite build",
        "electron:build": "npm run build && electron .",
        "pack": "npm run build && tsc -p tsconfig.server.json && cp src/backend/db.worker.cjs dist-server/ && electron-builder -l",
        "dist": "npm run build && electron-builder",
        "application": "concurrently \"tsx src/backend/server.ts\" \"wait-on http://localhost:5000/api/db-status && vite\""
    },
    "build": {
        "buildDependenciesFromSource": true,
        "npmRebuild": true,
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "node_modules/better-sqlite3/**/*",
            "node_modules/bindings/**/*",
            "node_modules/file-uri-to-path/**/*"
        ],
        "extraResources": [
            {
                "from": "db-config.json",
                "to": "db-config.json"
            },
            {
                "from": "dist-server/",
                "to": "dist-server/",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "linux": {
            "target": [
                {
                    "target": "deb",
                    "arch": [
                        "arm64"
                    ]
                }
            ],
            "category": "Utility"
        },
        "publish": {
            "provider": "github",
            "releaseType": "release"
        }
    },
    "dependencies": {
        "apexcharts": "^5.3.6",
        "better-sqlite3": "^12.6.2",
        "cors": "^2.8.6",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "lucide-react": "^0.577.0",
        "nanotimer": "^0.3.15",
        "performance": "^1.4.0",
        "react": "^19.2.0",
        "react-apexcharts": "^1.9.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^7.13.0"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.0.3",
        "@eslint/js": "^9.39.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/cors": "^2.8.19",
        "@types/electron": "^1.4.38",
        "@types/express": "^5.0.6",
        "@types/nanotimer": "^0.3.2",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "electron": "^40.0.0",
        "electron-builder": "^26.8.1",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.4",
        "vite": "^7.2.4",
        "vite-plugin-electron": "^0.29.0",
        "wait-on": "^9.0.4"
    }
}
